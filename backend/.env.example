# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Configuration
API_HOST=0.0.0.0
API_PORT=5180

# AI Services
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
ZEP_API_URL=your_zep_url
ZEP_API_KEY=your_zep_key
NEO4J_URI=your_neo4j_uri
NEO4J_USERNAME=your_neo4j_user
NEO4J_PASSWORD=your_neo4j_password

# Optional: speed up local dev by skipping external service checks on startup
SKIP_SERVICE_CHECKS=1

# Optional: database password for local dev/scripts
SUPABASE_DB_PASSWORD=your_db_password

#Clerk
VITE_CLERK_PUBLISHABLE_KEY=key
VITE_CLERK_SIGN_IN_URL=sign-in url
VITE_CLERK_SIGN_UP_URL=sign-up url
VITE_CLERK_AFTER_SIGN_IN_URL=/dashboard
VITE_CLERK_AFTER_SIGN_UP_URL=/onboarding
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=unauthorized-sign-in url   
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=sign-up url
