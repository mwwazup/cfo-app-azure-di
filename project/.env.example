# Frontend Environment Variables Example
# Copy this file to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API Configuration
# Used by both the frontend API client AND Vite dev server proxy
VITE_BACKEND_URL=http://localhost:8000

# AI Provider Configuration (VITE_ prefix required for browser access)
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_ANTHROPIC_API_KEY=your_claude_api_key_here

# Zep Cloud Memory Configuration (optional - for AI chat memory persistence)
# Get your API key from: https://app.getzep.com/
VITE_ZEP_API_KEY=your_zep_api_key_here

# Default AI Provider (claude or openai)
VITE_DEFAULT_AI_PROVIDER=claude

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_DEBUG=false

# Testing Configuration
SKIP_SERVICE_CHECKS=1   # skip calls to Supabase / Neo4j / OpenAI during tests
SKIP_DB=1               # skip all Postgres queries so tests pass without a DB