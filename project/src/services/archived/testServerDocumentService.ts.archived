/**
 * Test Server Document Service
 * 
 * This service replaces Azure Document Intelligence with a simplified test server approach.
 * It handles financial document processing using the test server API and mock data.
 * 
 * This eliminates Azure dependencies and UUID compatibility issues by using Clerk user IDs directly.
 */

import type { DocumentType, FinancialDocument, FinancialMetric } from '../models/FinancialStatement';

// API endpoint for test server
const API_BASE_URL = import.meta.env.VITE_BACKEND_URL || 'http://localhost:5180';

// Simplified extracted financial data interface
export interface ExtractedFinancialData {
  documentType: DocumentType;
  extractedFields: Record<string, { value: string | number; confidence: number }>;
  summary: {
    totalRevenue?: number;
    totalExpenses?: number;
    netProfit?: number;
  };
  document: {
    start_date: string;
    end_date: string;
    document_type: DocumentType;
  };
  metadata: {
    processingTime: number;
    confidence: number;
    documentId: string;
    extractedAt: string;
  };
}

/**
 * Test Server Document Service for simplified document processing
 * 
 * This service provides a mock implementation that works with the test server
 * and eliminates Azure dependencies while maintaining the same interface.
 */
export class TestServerDocumentService {
  /**
   * Process a financial document using mock extraction
   * @param file - The file to process (PDF or image)
   * @param documentType - Type of financial document
   * @returns Mock extracted financial data
   */
  static async processDocument(
    file: File,
    documentType: DocumentType
  ): Promise<ExtractedFinancialData> {
    const startTime = Date.now();
    
    try {
      console.log('🔍 Starting Test Server document processing...');
      console.log('📄 File:', file.name, 'Type:', documentType);
      
      // Simulate processing delay
      await new Promise(resolve => setTimeout(resolve, 2000));
      
      // Generate mock extracted data based on document type
      const mockData = this.generateMockData(documentType);
      
      return {
        documentType,
        extractedFields: mockData.fields,
        summary: mockData.summary,
        document: {
          start_date: new Date().toISOString().split('T')[0],
          end_date: new Date().toISOString().split('T')[0],
          document_type: documentType
        },
        metadata: {
          processingTime: Date.now() - startTime,
          confidence: 0.85,
          documentId: `mock-${Date.now()}`,
          extractedAt: new Date().toISOString(),
        }
      };
      
    } catch (error) {
      console.error('❌ Error processing document:', error);
      throw new Error(`Failed to process document: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Save processed financial document to test server
   */
  static async saveDocument(
    extractedData: ExtractedFinancialData,
    _metrics: FinancialMetric[],
    userId: string
  ): Promise<string> {
    try {
      console.log('💾 Saving document to test server...');
      
      // Prepare document data for test server
      const documentData = {
        userId: userId, // Use Clerk user ID directly
        document_type: extractedData.documentType,
        start_date: extractedData.document.start_date,
        end_date: extractedData.document.end_date,
        raw_json: extractedData.extractedFields,
        summary_metrics: extractedData.summary,
        confidence_score: extractedData.metadata.confidence,
        status: 'approved',
        source: 'test_server_upload',
        filename: `${extractedData.documentType}_${Date.now()}.pdf`,
        file_size: 1024000, // Mock file size
        file_type: 'application/pdf'
      };

      // Save to test server
      const response = await fetch(`${API_BASE_URL}/api/financial-documents`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(documentData),
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const result = await response.json();
      console.log('✅ Document saved successfully:', result.data.id);
      
      return result.data.id;
      
    } catch (error) {
      console.error('❌ Error saving document:', error);
      throw new Error(`Failed to save document: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Get financial documents for a user from test server
   */
  static async getFinancialDocuments(userId: string): Promise<FinancialDocument[]> {
    try {
      const response = await fetch(`${API_BASE_URL}/api/financial-documents?userId=${userId}`);

      if (!response.ok) {
        throw new Error(`Error fetching financial documents: HTTP ${response.status}`);
      }

      const result = await response.json();
      return result.data || [];
    } catch (error) {
      console.error('❌ Error getting financial documents:', error);
      throw new Error(`Failed to get financial documents: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Update document status
   */
  static async updateDocumentStatus(documentId: string, status: 'pending' | 'reviewed' | 'approved' | 'rejected'): Promise<void> {
    try {
      // For test server, we'll implement a simple status update
      console.log(`📝 Updating document ${documentId} status to: ${status}`);
      // Note: Test server doesn't have status update endpoint yet, so this is a mock
      console.log(`✅ Document status updated to: ${status}`);
    } catch (error) {
      console.error('❌ Error updating document status:', error);
      throw new Error(`Failed to update document status: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Delete a financial document
   */
  static async deleteDocument(documentId: string): Promise<void> {
    try {
      const response = await fetch(`${API_BASE_URL}/api/financial-documents/${documentId}`, {
        method: 'DELETE'
      });

      if (!response.ok) {
        throw new Error(`Error deleting financial document: HTTP ${response.status}`);
      }

      console.log('✅ Document deleted successfully');
    } catch (error) {
      console.error('❌ Error deleting document:', error);
      throw new Error(`Failed to delete document: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Delete an approved document (same as regular delete for test server)
   */
  static async deleteApprovedDocument(documentId: string): Promise<{
    success: boolean;
    affectedKPIs: string[];
    rollbackData?: any;
  }> {
    try {
      await this.deleteDocument(documentId);
      
      return {
        success: true,
        affectedKPIs: ['Revenue Growth', 'Profit Margin', 'Cash Flow Ratio'], // Mock affected KPIs
      };
    } catch (error) {
      console.error('❌ Error deleting approved document:', error);
      throw new Error(`Failed to delete approved document: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Get financial metrics for a specific document (mock implementation)
   */
  static async getFinancialMetrics(documentId: string): Promise<FinancialMetric[]> {
    try {
      // Mock metrics for test server
      return [
        {
          id: `${documentId}_revenue`,
          document_id: documentId,
          label: 'Total Revenue',
          value: 150000,
          category: 'Revenue',
          is_verified: true
        },
        {
          id: `${documentId}_expenses`,
          document_id: documentId,
          label: 'Total Expenses',
          value: 120000,
          category: 'Expenses',
          is_verified: true
        },
        {
          id: `${documentId}_profit`,
          document_id: documentId,
          label: 'Net Profit',
          value: 30000,
          category: 'Profit',
          is_verified: true
        }
      ];
    } catch (error) {
      console.error('❌ Error getting financial metrics:', error);
      throw new Error(`Failed to get financial metrics: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Generate mock financial data based on document type
   */
  private static generateMockData(documentType: DocumentType): {
    fields: Record<string, { value: number; confidence: number }>;
    summary: { totalRevenue: number; totalExpenses: number; netProfit: number };
  } {
    const baseRevenue = 100000 + Math.random() * 50000;
    const baseExpenses = baseRevenue * (0.7 + Math.random() * 0.2);
    const netProfit = baseRevenue - baseExpenses;

    const summary = {
      totalRevenue: baseRevenue,
      totalExpenses: baseExpenses,
      netProfit: netProfit
    };

    switch (documentType) {
      case 'pnl':
        return {
          fields: {
            total_revenue: { value: baseRevenue, confidence: 0.9 },
            cost_of_goods_sold: { value: baseExpenses * 0.6, confidence: 0.85 },
            operating_expenses: { value: baseExpenses * 0.4, confidence: 0.85 },
            net_income: { value: netProfit, confidence: 0.9 }
          },
          summary
        };
      
      case 'balance_sheet':
        return {
          fields: {
            total_assets: { value: baseRevenue * 2, confidence: 0.85 },
            total_liabilities: { value: baseRevenue * 0.8, confidence: 0.85 },
            total_equity: { value: baseRevenue * 1.2, confidence: 0.85 }
          },
          summary
        };
      
      case 'cash_flow':
        return {
          fields: {
            operating_cash_flow: { value: netProfit * 1.1, confidence: 0.85 },
            investing_cash_flow: { value: -baseRevenue * 0.1, confidence: 0.8 },
            financing_cash_flow: { value: baseRevenue * 0.05, confidence: 0.8 }
          },
          summary
        };
      
      default:
        return {
          fields: {
            total_revenue: { value: baseRevenue, confidence: 0.8 }
          },
          summary
        };
    }
  }
}
